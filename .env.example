# AWS credentials for Claude on Bedrock
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Google Drive OAuth2 credentials JSON (downloaded from Google Cloud Console)
GOOGLE_CREDENTIALS_PATH=~/.config/meet-analyzer/credentials.json

# Where to store the OAuth2 token after first-run consent (optional, has default)
GOOGLE_TOKEN_PATH=~/.config/meet-analyzer/token.json

# Drive folder to search for transcripts (optional, defaults to "Meet Recordings")
GOOGLE_DRIVE_FOLDER_NAME=Meet Recordings
